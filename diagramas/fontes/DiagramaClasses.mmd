---
config:
  class:
    nodeSpacing: 150
    rankSpacing: 130
---
classDiagram
    class Usuario {
        id
        nome
        email
    }
    class Organizador
    class Categoria {
        id
        nome
    }
    class Evento {
        id
        nome
        descricao
        dataHora
        local
        valorIngresso
        quantidadeDisponivel
        reservarIngressos(qtd)
        liberarIngressos(qtd)
    }
    class Pedido {
        id
        data
        valorTotal
        status
        calcularTotal()
        marcarComoPago()
        cancelar()
    }
    class Ingresso {
        id
        codigoQR
        utilizado
        marcarUtilizado()
    }
    class Pagamento {
        id
        idTransacao
        valor
        status
        registrar(idTransacao, status)
    }
    class Notificacao {
        id
        mensagem
        dataEnvio
    }

    Usuario <|-- Organizador
    Usuario "1" --> "0..n" Pedido : realiza
    Usuario "1" --> "0..n" Notificacao : recebe
    Organizador "1" --> "0..n" Evento : organiza
    Notificacao "0..n" --> "1" Evento : sobre
    Evento "0..n" --> "1" Categoria : pertence a
    Pedido "1" *-- "1..n" Ingresso : contém
    Pedido "1" --> "0..1" Pagamento : pago por
    Evento "1" --> "0..n" Ingresso : refere-se a
